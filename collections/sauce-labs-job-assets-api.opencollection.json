{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sauce Labs Jobs Devices Job Assets API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Job Assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a Job Asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us-west-1.saucelabs.com/v1/jobs/:id/:assetName",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "assetName",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Download a job asset such as log files, screenshots, or video recordings. Common asset names include `selenium-server.log`, `video.mp4`, and `screenshots.zip`."
        }
      ]
    }
  ],
  "bundled": true
}