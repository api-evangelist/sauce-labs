{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sauce Labs Jobs Devices API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Available Devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us-west-1.saucelabs.com/devices",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Filter devices by organization."
              },
              {
                "name": "os",
                "value": "",
                "type": "query",
                "description": "Filter by operating system."
              }
            ]
          },
          "docs": "Returns the list of real devices available in the Sauce Labs cloud."
        },
        {
          "info": {
            "name": "Get Device Availability Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.us-west-1.saucelabs.com/devices/status"
          },
          "docs": "Returns availability status for all devices in the cloud."
        }
      ]
    }
  ],
  "bundled": true
}